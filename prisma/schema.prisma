// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                @id @default(autoincrement())
  email                    String             @unique
  password                 String
  documentsUploaded        Document[]         @relation("Uploader")
  documentsOwned           Document[]         @relation("Owner")
  requestedSignatureRequests SignatureRequest[] @relation("Requester")
  signedSignatureRequests  SignatureRequest[] @relation("Signer")
}

model Document {
  id                  String             @id @default(uuid())
  title               String
  description         String?
  uploader_id         Int
  uploader            User               @relation("Uploader", fields: [uploader_id], references: [id])
  uploaded_at         DateTime           @default(now())
  owner_id            Int
  owner               User               @relation("Owner", fields: [owner_id], references: [id])
  original_filename   String
  stored_filename     String             @unique
  storage_path        String
  filesize            Int
  status              String // Assuming this is document status, not signature status
  original_hash       String?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  signatureRequests   SignatureRequest[] @relation("DocumentSignatures")
}

model SignatureRequest {
  id                 Int      @id @default(autoincrement())
  documentId         String   // Matched to Document's id type (String)
  document           Document @relation("DocumentSignatures", fields: [documentId], references: [id])
  requesterId        Int
  requester          User     @relation("Requester", fields: [requesterId], references: [id])
  signerId           Int
  signer             User     @relation("Signer", fields: [signerId], references: [id])
  status             String   @default("PENDING") // e.g., PENDING, APPROVED, REJECTED
  rejectionReason    String?
  qrCodeUrl          String? // URL encoded in the QR
  signedDocumentPath String? // path to the signed document
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
